# workflow. Ignore only machine-specific local overrides:
.claude/settings.local.json

# ── Node (built apps & verification projects under projects/) ──
node_modules/
dist/
build/
coverage/
.cache/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Playwright / test output ──
test-results/
playwright-report/
playwright/.cache/
blob-report/

# ── Python ──
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ── Secrets / environment ──
.env
.env.*
!.env.example
*.pem
*.key

# ── Logs / temp ──
*.log
*.tmp
tmp/

# ── Audit runtime output (generated by the audit worker) ──
audit/state/
audit/reports/
.product-workflow-audit/
